---
import { studioApps } from "../content/studio";
import StudioLayout from "../layouts/StudioLayout.astro";
---

<StudioLayout
  title="Page not found | Sarper Studios"
  description="The requested page could not be found."
  robots="noindex,follow"
>
  <section class="ss-entry ss-shell" aria-labelledby="not-found-heading">
    <p class="ss-entry__code">404</p>
    <h1 id="not-found-heading">Page not found</h1>
    <p>This address does not exist. Each app on this site has its own page:</p>
    <ul class="ss-apps">
      {
        studioApps.map((app) => (
          <li class="ss-app">
            <img class="ss-app__mark" src={app.mark} width="52" height="52" alt="" />
            <div>
              <h2 class="ss-app__name">
                <a href={app.href}>{app.name}</a>
              </h2>
              <p class="ss-app__kind">{app.kind}</p>
            </div>
            <p class="ss-app__line">{app.line}</p>
            <ul class="ss-app__links" aria-label={app.name}>
              {app.privacyHref && <li><a href={app.privacyHref}>Privacy policy</a></li>}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>
</StudioLayout>
