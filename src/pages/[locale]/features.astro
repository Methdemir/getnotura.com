---
import Icon from "../../components/Icon.astro";
import PageIntro from "../../components/PageIntro.astro";
import { publishedLocales, type LocaleDefinition } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { translate, type TranslationKey } from "../../i18n/translations";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({
    params: { locale: locale.urlPrefix },
    props: { locale },
  }));
}

interface Props {
  locale: LocaleDefinition;
}

const { locale } = Astro.props;
const t = (key: TranslationKey) => translate(locale.id, key);

const features: Array<[TranslationKey, TranslationKey]> = [
  ["featureCaptureTitle", "featureCaptureBody"],
  ["featureNutritionTitle", "featureNutritionBody"],
  ["featureTrackingTitle", "featureTrackingBody"],
  ["featureProgressTitle", "featureProgressBody"],
];
---

<BaseLayout
  localeId={locale.id}
  destination="features"
  title={t("metaFeaturesTitle")}
  description={t("metaFeaturesDescription")}
>
  <PageIntro heading={t("featuresHeading")} body={t("featuresBody")} />

  <section class="bay shell" aria-label={t("featuresHeading")}>
    <div class="features">
      {
        features.map(([titleKey, bodyKey]) => (
          <article>
            <h2>{t(titleKey)}</h2>
            <p>{t(bodyKey)}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bay bay--field" aria-labelledby="feature-boundary-heading">
    <div class="shell statement">
      <h2 id="feature-boundary-heading">{t("featuresBoundaryHeading")}</h2>
      <p>{t("featuresBoundaryBody")}</p>
    </div>
  </section>

  <div class="shell">
    <section class="close" aria-labelledby="features-close">
      <div>
        <h2 id="features-close">{t("productHeading")}</h2>
        <p>{t("productBody")}</p>
      </div>
      <div class="action-row">
        <a class="action action--primary" href={localizedPath(locale.id, "product")}>
          {t("viewProduct")}
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
