---
import CaptureDemo from "../../components/CaptureDemo.astro";
import Demonstration from "../../components/Demonstration.astro";
import EstimateField from "../../components/EstimateField.astro";
import Icon from "../../components/Icon.astro";
import type { IconName } from "../../components/icons";
import PageIntro from "../../components/PageIntro.astro";
import TimelineDemo from "../../components/TimelineDemo.astro";
import { publishedLocales, type LocaleDefinition } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { translate, type TranslationKey } from "../../i18n/translations";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({
    params: { locale: locale.urlPrefix },
    props: { locale },
  }));
}

interface Props {
  locale: LocaleDefinition;
}

const { locale } = Astro.props;
const t = (key: TranslationKey) => translate(locale.id, key);

const captureMethods: Array<{ icon: IconName; label: TranslationKey }> = [
  { icon: "camera", label: "methodPhoto" },
  { icon: "gallery", label: "methodGallery" },
  { icon: "text", label: "methodText" },
  { icon: "saved", label: "methodSaved" },
  { icon: "manual", label: "methodManual" },
  { icon: "barcode", label: "methodBarcode" },
];

const items = (key: TranslationKey) => t(key).split("|");
---

<BaseLayout
  localeId={locale.id}
  destination="product"
  title={t("metaProductTitle")}
  description={t("metaProductDescription")}
>
  <PageIntro heading={t("productHeading")} body={t("productBody")} />

  <section class="bay bay--field" aria-labelledby="group-log">
    <div class="shell split split--wide">
      <div>
        <h2 id="group-log">{t("groupLogTitle")}</h2>
        <p class="lede lede--tight">{t("groupLogBody")}</p>
        <ul class="ledger__items ledger__items--field">
          {items("groupLogItems").map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <Demonstration
        tone="field"
        label={t("demonstrationLabel")}
        caption={t("captureHeading")}
      >
        <CaptureDemo
          methods={captureMethods.map((m) => ({ icon: m.icon, label: t(m.label) }))}
          destination={t("oneRecord")}
        />
      </Demonstration>
    </div>
  </section>

  <section class="bay" aria-labelledby="group-understand">
    <div class="shell split split--wide split--reverse">
      <Demonstration label={t("demonstrationLabel")} caption={t("estimateLabel")}>
        <EstimateField
          tone="light"
          protein={t("protein")}
          carbs={t("carbs")}
          fat={t("fat")}
          estimated={t("estimated")}
          notDetermined={t("notDetermined")}
          note={t("estimateNote")}
          label={t("estimateLabel")}
        />
      </Demonstration>
      <div>
        <h2 id="group-understand">{t("groupUnderstandTitle")}</h2>
        <p class="lede lede--tight">{t("groupUnderstandBody")}</p>
        <ul class="ledger__items">
          {items("groupUnderstandItems").map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bay bay--raised" aria-labelledby="group-track">
    <div class="shell">
      <div class="split split--wide">
        <div>
          <h2 id="group-track">{t("groupTrackTitle")}</h2>
          <p class="lede lede--tight">{t("groupTrackBody")}</p>
          <ul class="ledger__items">
            {items("groupTrackItems").map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <h2>{t("groupReviewTitle")}</h2>
          <p class="lede lede--tight">{t("groupReviewBody")}</p>
          <ul class="ledger__items">
            {items("groupReviewItems").map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="bay-gap">
        <Demonstration label={t("demonstrationLabel")} caption={t("periodProgress")}>
          <TimelineDemo
            progress={t("periodProgress")}
            water={t("waterTracking")}
            weight={t("weightTracking")}
            notDetermined={t("notDetermined")}
          />
        </Demonstration>
      </div>
    </div>
  </section>

  <div class="shell">
    <aside class="note" aria-labelledby="truth-heading">
      <h2 id="truth-heading">{t("productTruthHeading")}</h2>
      <p>{t("productTruthBody")}</p>
    </aside>

    <section class="close" aria-labelledby="product-close">
      <div>
        <h2 id="product-close">{t("closingHeading")}</h2>
        <p>{t("closingBody")}</p>
      </div>
      <div class="action-row">
        <a class="action action--primary" href={localizedPath(locale.id, "howItWorks")}>
          {t("seeHow")}
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
