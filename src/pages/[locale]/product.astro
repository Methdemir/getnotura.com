---
import Icon from "../../components/Icon.astro";
import PageIntro from "../../components/PageIntro.astro";
import { publishedLocales, type LocaleDefinition } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { translate, type TranslationKey } from "../../i18n/translations";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({
    params: { locale: locale.urlPrefix },
    props: { locale },
  }));
}

interface Props {
  locale: LocaleDefinition;
}

const { locale } = Astro.props;
const t = (key: TranslationKey) => translate(locale.id, key);

const groups: Array<[TranslationKey, TranslationKey, TranslationKey]> = [
  ["groupLogTitle", "groupLogBody", "groupLogItems"],
  ["groupUnderstandTitle", "groupUnderstandBody", "groupUnderstandItems"],
  ["groupTrackTitle", "groupTrackBody", "groupTrackItems"],
  ["groupReviewTitle", "groupReviewBody", "groupReviewItems"],
];
---

<BaseLayout
  localeId={locale.id}
  destination="product"
  title={t("metaProductTitle")}
  description={t("metaProductDescription")}
>
  <PageIntro heading={t("productHeading")} body={t("productBody")} />

  <section class="bay shell ledger" aria-label={t("currentCapability")}>
    {
      groups.map(([titleKey, bodyKey, itemsKey]) => (
        <article class="ledger__group">
          <div>
            <h2>{t(titleKey)}</h2>
            <p>{t(bodyKey)}</p>
          </div>
          <ul class="ledger__items">
            {t(itemsKey)
              .split("|")
              .map((item) => (
                <li>{item}</li>
              ))}
          </ul>
        </article>
      ))
    }
  </section>

  <div class="shell">
    <aside class="note" aria-labelledby="truth-heading">
      <h2 id="truth-heading">{t("productTruthHeading")}</h2>
      <p>{t("productTruthBody")}</p>
    </aside>

    <section class="close" aria-labelledby="product-close">
      <div>
        <h2 id="product-close">{t("closingHeading")}</h2>
        <p>{t("closingBody")}</p>
      </div>
      <div class="action-row">
        <a class="action action--primary" href={localizedPath(locale.id, "howItWorks")}>
          {t("seeHow")}
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
