---
import PageIntro from "../../components/PageIntro.astro";
import { publishedLocales, type LocaleDefinition } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { translate, type TranslationKey } from "../../i18n/translations";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({ params: { locale: locale.urlPrefix }, props: { locale } }));
}

interface Props { locale: LocaleDefinition; }
const { locale } = Astro.props as Props;
const t = (key: TranslationKey) => translate(locale.id, key);
const steps = [
  ["step1Title", "step1Body"],
  ["step2Title", "step2Body"],
  ["step3Title", "step3Body"],
  ["step4Title", "step4Body"],
] as const;
---

<BaseLayout localeId={locale.id} destination="howItWorks" title={t("metaHowTitle")} description={t("metaHowDescription")}>
  <div class="section-shell">
    <PageIntro eyebrow={t("howEyebrow")} heading={t("howHeading")} body={t("howBody")} compact />
  </div>
  <section class="process section-shell" aria-label={t("howHeading")}>
    <ol>
      {steps.map(([titleKey, bodyKey], index) => (
        <li>
          <span class="process__number" aria-hidden="true">{index + 1}</span>
          <div><h2>{t(titleKey)}</h2><p>{t(bodyKey)}</p></div>
        </li>
      ))}
    </ol>
  </section>
  <aside class="adjust-note">
    <div class="section-shell split-layout">
      <div class="adjust-note__symbol" aria-hidden="true"><img src="/favicon/notura-symbol.png" width="96" height="96" alt="" /></div>
      <div><h2>{t("adjustNoteHeading")}</h2><p>{t("adjustNoteBody")}</p></div>
    </div>
  </aside>
  <section class="closing-section section-shell">
    <h2>{t("howClosing")}</h2>
    <a class="button button--primary" href={localizedPath(locale.id, "features")}>{t("exploreFeatures")}</a>
  </section>
</BaseLayout>
