---
/**
 * The arc, in six steps: add, review, adjust, see the pattern, keep the record,
 * share it if you want. The first four were already here; the last two exist
 * because PDF reports and Community now ship, and the flow was ending one
 * movement before the product does.
 */
import AppScreen from "../../components/AppScreen.astro";
import CorrectionDemo from "../../components/CorrectionDemo.astro";
import Demonstration from "../../components/Demonstration.astro";
import Icon from "../../components/Icon.astro";
import PageIntro from "../../components/PageIntro.astro";
import { publishedLocales, type LocaleDefinition } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { translate, type TranslationKey } from "../../i18n/translations";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({
    params: { locale: locale.urlPrefix },
    props: { locale },
  }));
}

interface Props {
  locale: LocaleDefinition;
}

const { locale } = Astro.props;
const t = (key: TranslationKey) => translate(locale.id, key);

const opening: Array<[TranslationKey, TranslationKey]> = [
  ["step1Title", "step1Body"],
  ["step2Title", "step2Body"],
];

const closingSteps: Array<[TranslationKey, TranslationKey]> = [
  ["step4Title", "step4Body"],
  ["step5Title", "step5Body"],
  ["step6Title", "step6Body"],
];
---

<BaseLayout
  localeId={locale.id}
  destination="howItWorks"
  title={t("metaHowTitle")}
  description={t("metaHowDescription")}
>
  <PageIntro heading={t("howHeading")} body={t("howBody")} />

  <section class="bay" aria-label={t("howHeading")}>
    <div class="shell split split--plate">
      <ol class="process">
        {
          opening.map(([titleKey, bodyKey]) => (
            <li>
              <h2>{t(titleKey)}</h2>
              <p>{t(bodyKey)}</p>
            </li>
          ))
        }
      </ol>
      <AppScreen
        src="add-a-meal"
        alt={t("screenAddMealAlt")}
        caption={t("screenAddMealCaption")}
        label={t("screenshotLabel")}
        tone="light"
      />
    </div>
  </section>

  <section class="bay bay--field" aria-labelledby="step3-heading">
    <div class="shell">
      <ol class="process process--field" style="counter-reset: step 2">
        <li>
          <h2 id="step3-heading">{t("step3Title")}</h2>
          <p>{t("step3Body")}</p>
        </li>
      </ol>
      <div class="bay-gap">
        <Demonstration
          tone="field"
          label={t("demonstrationLabel")}
          caption={t("adjustNoteHeading")}
        >
          <CorrectionDemo
            protein={t("protein")}
            carbs={t("carbs")}
            fat={t("fat")}
            estimated={t("estimated")}
            corrected={t("corrected")}
            notDetermined={t("notDetermined")}
          />
        </Demonstration>
      </div>
    </div>
  </section>

  <section class="bay shell" aria-label={t("step4Title")}>
    <ol class="process" style="counter-reset: step 3">
      {
        closingSteps.map(([titleKey, bodyKey]) => (
          <li>
            <h2>{t(titleKey)}</h2>
            <p>{t(bodyKey)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bay bay--raised" aria-labelledby="adjust-heading">
    <div class="shell statement">
      <h2 id="adjust-heading">{t("adjustNoteHeading")}</h2>
      <p>{t("adjustNoteBody")}</p>
    </div>
  </section>

  <div class="shell">
    <section class="close" aria-labelledby="how-close">
      <div>
        <h2 id="how-close">{t("howClosing")}</h2>
      </div>
      <div class="action-row">
        <a class="action action--primary" href={localizedPath(locale.id, "features")}>
          {t("exploreFeatures")}
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
