---
/**
 * The four decisions, not a second inventory.
 *
 * This page used to restate the product page with different headings — the same
 * capabilities listed twice, in two places to keep in sync. It now covers only
 * where Notura chose differently: flexible capture, estimates you can check,
 * PDF reports, and a Community you control. The full list lives on /product/,
 * once.
 */
import AppScreen from "../../../components/AppScreen.astro";
import CaptureDemo from "../../../components/CaptureDemo.astro";
import CommunityDemo from "../../../components/CommunityDemo.astro";
import Demonstration from "../../../components/Demonstration.astro";
import EstimateField from "../../../components/EstimateField.astro";
import Icon from "../../../components/Icon.astro";
import type { IconName } from "../../../components/icons";
import PageIntro from "../../../components/PageIntro.astro";
import { publishedLocales, type LocaleDefinition } from "../../../i18n/locales";
import { localizedPath } from "../../../i18n/routes";
import { translate, type TranslationKey } from "../../../i18n/translations";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return publishedLocales.map((locale) => ({
    params: { locale: locale.urlPrefix },
    props: { locale },
  }));
}

interface Props {
  locale: LocaleDefinition;
}

const { locale } = Astro.props;
const t = (key: TranslationKey) => translate(locale.id, key);

const captureMethods: Array<{ icon: IconName; label: TranslationKey }> = [
  { icon: "camera", label: "methodPhoto" },
  { icon: "gallery", label: "methodGallery" },
  { icon: "text", label: "methodText" },
  { icon: "saved", label: "methodSaved" },
  { icon: "manual", label: "methodManual" },
  { icon: "barcode", label: "methodBarcode" },
];
---

<BaseLayout
  localeId={locale.id}
  destination="features"
  title={t("metaFeaturesTitle")}
  description={t("metaFeaturesDescription")}
>
  <PageIntro heading={t("featuresHeading")} body={t("featuresBody")} />

  <section class="bay" aria-labelledby="feature-capture">
    <div class="shell split split--wide">
      <div>
        <h2 id="feature-capture">{t("featureCaptureTitle")}</h2>
        <p class="lede lede--tight">{t("featureCaptureBody")}</p>
      </div>
      <Demonstration label={t("demonstrationLabel")} caption={t("captureHeading")}>
        <CaptureDemo
          methods={captureMethods.map((m) => ({ icon: m.icon, label: t(m.label) }))}
          destination={t("oneRecord")}
        />
      </Demonstration>
    </div>
  </section>

  <section class="bay bay--field" aria-labelledby="feature-nutrition">
    <div class="shell split split--wide split--reverse">
      <Demonstration tone="field" label={t("demonstrationLabel")} caption={t("estimateLabel")}>
        <EstimateField
          protein={t("protein")}
          carbs={t("carbs")}
          fat={t("fat")}
          estimated={t("estimated")}
          notDetermined={t("notDetermined")}
          note={t("estimateNote")}
          label={t("estimateLabel")}
        />
      </Demonstration>
      <div>
        <h2 id="feature-nutrition">{t("featureNutritionTitle")}</h2>
        <p class="lede lede--tight">{t("featureNutritionBody")}</p>
      </div>
    </div>
  </section>

  <section class="bay bay--raised" aria-labelledby="feature-reports">
    <div class="shell split split--plate">
      <div>
        <h2 id="feature-reports">{t("featureReportsTitle")}</h2>
        <p class="lede lede--tight">{t("featureReportsBody")}</p>
        <p class="boundary">{t("reportsBoundary")}</p>
      </div>
      <AppScreen
        src="pdf-report"
        alt={t("screenReportAlt")}
        caption={t("screenReportCaption")}
        label={t("screenshotLabel")}
        tone="light"
      />
    </div>
  </section>

  <section class="bay bay--field" aria-labelledby="feature-community">
    <div class="shell split split--plate split--reverse">
      <AppScreen caption={t("communityScreenCaption")} label={t("demonstrationLabel")} tone="field">
        <CommunityDemo
          mealSharing={t("communityMealSharingLabel")}
          goalSharing={t("communityGoalSharingLabel")}
          stateOn={t("communityStateOnToday")}
          stateOff={t("communityStateOff")}
          friend={t("communityFriendLabel")}
          sharedMeal={t("communitySharedMealLabel")}
          expiry={t("communityExpiryLabel")}
        />
      </AppScreen>
      <div>
        <h2 id="feature-community">{t("featureCommunityTitle")}</h2>
        <p class="lede lede--tight">{t("featureCommunityBody")}</p>
      </div>
    </div>
  </section>

  <section class="bay bay--deep" aria-labelledby="feature-boundary-heading">
    <div class="shell statement">
      <h2 id="feature-boundary-heading">{t("featuresBoundaryHeading")}</h2>
      <p>{t("featuresBoundaryBody")}</p>
    </div>
  </section>

  <div class="shell">
    <section class="close" aria-labelledby="features-close">
      <div>
        <h2 id="features-close">{t("productHeading")}</h2>
        <p>{t("productBody")}</p>
      </div>
      <div class="action-row">
        <a class="action action--primary" href={localizedPath(locale.id, "product")}>
          {t("viewProduct")}
          <Icon name="arrow" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
