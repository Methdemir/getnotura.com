---
/**
 * The MomentBack mark: a ring that closes counter-clockwise around a lens.
 *
 * This is the app's own launcher geometry (apps/ReplayCamera
 * res/drawable/ic_launcher_foreground.xml), not a website invention — back, not
 * forward, around the thing the camera is looking at. The orange lens (open
 * centre: aperture and record button) matches SAVE; turquoise stays reserved for the app's live buffer status.
 */
interface Props {
  class?: string | undefined;
  title?: string | undefined;
}

const { class: className, title } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  role={title ? "img" : "presentation"}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  fill="none"
>
  <path
    d="M6.6 5.566A8.4 8.4 0 1 0 17.4 5.566"
    stroke="currentColor"
    stroke-width="2.8"
    stroke-linecap="round"
  />
  <path d="M14.49 3.12 19.64 3.52 15.78 8.12Z" fill="currentColor" />
  <path
    d="M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 1 0 0-9.2Zm0 2.9a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 1 0 0-3.4Z"
    fill="#FF8A3D"
    fill-rule="evenodd"
  />
</svg>
