---
/**
 * The MomentBack mark: a ring that closes counter-clockwise around a lens.
 *
 * This is the app's own launcher geometry (apps/ReplayCamera
 * res/drawable/ic_launcher_foreground.xml), not a website invention — back, not
 * forward, around the thing the camera is looking at. It is provisional artwork
 * in the app too; when the final mark lands, both files change together.
 */
interface Props {
  class?: string | undefined;
  title?: string | undefined;
}

const { class: className, title } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  role={title ? "img" : "presentation"}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
  fill="none"
>
  <path
    d="M6.215 5.106A9 9 0 1 0 17.79 5.106"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
  />
  <path d="M14.57 2.41 19.41 2.55 15.55 7.15Z" fill="currentColor" />
  <circle cx="12" cy="12" r="3.2" fill="#3FD8C4" />
</svg>
