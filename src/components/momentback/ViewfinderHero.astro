---
/**
 * The hero is the viewfinder. The visitor lands inside the camera screen.
 *
 * Every word on the HUD is the app's own string for that locale, laid out the
 * way the app lays it out (camera_chrome.dart): Clips top-left, the buffer chip
 * top-centre, flip and settings top-right, the duration rail and the big
 * orange SAVE at the bottom. Nothing the app does not have is drawn — no REC
 * dot, no audio meters, no grid.
 *
 * The scene behind it is built from gradients: no stock image, no video, no
 * fake capture. It is labelled as a drawing, and links to the real screens.
 *
 * Motion is CSS only. The chip counts held seconds in real time with an
 * @property integer and turns into READY when the window is full, the way the
 * app does. With reduced motion it simply reads READY.
 */
import type { MomentBackCopy } from "../../content/momentback";

interface Props {
  home: MomentBackCopy["home"];
}

const { home } = Astro.props;
const hud = home.hud;
---

<section class="mb-vf" aria-labelledby="mb-hero-heading">
  <div class="mb-vf__scene" aria-hidden="true">
    <i class="mb-vf__sky"></i>
    <i class="mb-vf__sun"></i>
    <i class="mb-vf__ridge mb-vf__ridge--far"></i>
    <i class="mb-vf__ridge mb-vf__ridge--near"></i>
    <i class="mb-vf__bokeh"></i>
    <i class="mb-vf__grain"></i>
  </div>

  <div class="mb-vf__frame">
    <div class="mb-vf__top" aria-hidden="true">
      <span class="mb-hud-btn mb-hud-btn--square">
        <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="3"></rect><path d="m7 16 3.5-4 2.5 3 2-2 2 3"></path></svg>
      </span>
      <span class="mb-hud-chip">
        <i class="mb-hud-chip__ring"></i>
        <span class="mb-hud-chip__text">
          <span class="mb-hud-chip__fill"><span class="mb-hud-count"></span>{hud.fillSuffix}</span>
          <span class="mb-hud-chip__ready">{hud.ready}</span>
        </span>
      </span>
      <span class="mb-vf__tools">
        <span class="mb-hud-btn">
          <svg viewBox="0 0 24 24"><path d="M9 6.5 10.3 5h3.4L15 6.5h2.5A1.5 1.5 0 0 1 19 8v8.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 16.5V8a1.5 1.5 0 0 1 1.5-1.5z"></path><path d="M9.2 12.2a2.8 2.8 0 0 1 4.9-1.6M14.8 12.6a2.8 2.8 0 0 1-4.9 1.6"></path><path d="m14.6 9.2-.5 1.5-1.5-.4M9.4 15.6l.5-1.5 1.5.4"></path></svg>
        </span>
        <span class="mb-hud-btn">
          <svg viewBox="0 0 24 24"><path d="M4 7h9M17 7h3M4 12h3M11 12h9M4 17h11M19 17h1"></path><circle cx="15" cy="7" r="2"></circle><circle cx="9" cy="12" r="2"></circle><circle cx="17" cy="17" r="2"></circle></svg>
        </span>
      </span>
    </div>

    <div class="mb-vf__copy">
      <p class="mb-label mb-vf__eyebrow"><span class="mb-dot"></span>{home.eyebrow}</p>
      <h1 id="mb-hero-heading" class="mb-two-voice">
        <span class="mb-two-voice__plain">{home.heading.plain}</span>
        <span class="mb-two-voice__serif">{home.heading.serif}</span>
      </h1>
      <p class="mb-vf__lede">{home.lede}</p>
    </div>

    <div class="mb-vf__focus" aria-hidden="true">
      <i class="mb-vf__reticle"></i>
      <span class="mb-vf__zoom">{hud.zoom}</span>
    </div>

    <div class="mb-vf__bottom" aria-hidden="true">
      <ul class="mb-hud-rail">
        {
          hud.durations.map((duration, index) => (
            <li data-selected={index === 1 ? "" : undefined} data-locked={index > 1 ? "" : undefined}>
              {duration}
              {index > 1 && (
                <svg viewBox="0 0 12 12" class="mb-hud-lock">
                  <rect x="2.5" y="5.2" width="7" height="5" rx="1.2" />
                  <path d="M4.2 5.2V4a1.8 1.8 0 0 1 3.6 0v1.2" />
                </svg>
              )}
            </li>
          ))
        }
      </ul>
      <span class="mb-hud-save">{hud.save}</span>
      <span class="mb-hud-hint">{hud.hint}</span>
    </div>

    <ul class="mb-vf__readouts" aria-hidden="true">
      {hud.readouts.map((readout) => <li>{readout}</li>)}
    </ul>

    <a class="mb-vf__tag" href="#tour">{hud.tag}</a>
    <p class="mb-sr-only">{hud.alt}</p>

    <i class="mb-vf__corner mb-vf__corner--tl" aria-hidden="true"></i>
    <i class="mb-vf__corner mb-vf__corner--tr" aria-hidden="true"></i>
    <i class="mb-vf__corner mb-vf__corner--bl" aria-hidden="true"></i>
    <i class="mb-vf__corner mb-vf__corner--br" aria-hidden="true"></i>
  </div>
</section>

<div class="mb-status">
  <div class="mb-shell mb-status__inner">
    <p class="mb-status__store"><span class="mb-dot"></span>{home.cta}</p>
    <ul class="mb-status__facts">
      {home.platform.map((fact) => <li>{fact}</li>)}
    </ul>
    <p class="mb-status__note">{home.ctaNote}</p>
    <a class="mb-link" href="#tour">{home.secondary}</a>
  </div>
</div>
