---
import { getMomentBackCopy, momentBackPath, type MomentBackLocale } from "../../content/momentback";
import AppTour from "./AppTour.astro";
import ReplayTimeline from "./ReplayTimeline.astro";
import ViewfinderHero from "./ViewfinderHero.astro";

interface Props {
  locale: MomentBackLocale;
}

const { locale } = Astro.props;
const copy = getMomentBackCopy(locale);
const home = copy.home;

/* Licensed photographs (Unsplash License), one 4:3 crop per moment. */
const photoBase = "/momentback/photos";
const moments = home.moments.items.map((moment, index) => ({
  ...moment,
  index: String(index + 1).padStart(2, "0"),
  file: `${photoBase}/moment-${moment.photo}`,
}));
---

<ViewfinderHero home={home} />

<section class="mb-rail-sec" aria-labelledby="mb-rail-heading">
  <div class="mb-shell">
    <p class="mb-label mb-label--quiet">{home.rail.label}</p>
    <h2 id="mb-rail-heading" class="mb-sr-only">{home.rail.heading}</h2>
    <ol class="mb-verbs">
      {
        home.rail.steps.map((step) => (
          <li class={`mb-verb mb-verb--${step.tone}`}>
            <p class="mb-verb__head">
              <span class="mb-verb__index">{step.index}</span>
              <span class="mb-verb__word">{step.verb}</span>
            </p>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="how" class="mb-bay mb-bay--raised" aria-labelledby="mb-how-heading">
  <div class="mb-shell">
    <div class="mb-intro">
      <p class="mb-label"><span class="mb-dot"></span>{home.how.label}</p>
      <h2 id="mb-how-heading">{home.how.heading}</h2>
      <p>{home.how.body}</p>
    </div>
    <ReplayTimeline labels={home.how.timeline} />
  </div>
</section>

<section id="tour" class="mb-bay" aria-labelledby="mb-tour-heading">
  <div class="mb-shell">
    <div class="mb-intro">
      <p class="mb-label"><span class="mb-dot"></span>{home.tour.label}</p>
      <h2 id="mb-tour-heading">{home.tour.heading}</h2>
      <p>{home.tour.body}</p>
    </div>
    <AppTour tour={home.tour} />
  </div>
</section>

<section class="mb-figures-sec" aria-labelledby="mb-figures-heading">
  <div class="mb-shell">
    <p class="mb-label mb-label--quiet">{home.figures.label}</p>
    <h2 id="mb-figures-heading" class="mb-sr-only">{home.figures.heading}</h2>
    <ul class="mb-figures">
      {
        home.figures.items.map((figure) => (
          <li>
            <p class="mb-figure__value">
              <span class="mb-figure__count" style={`--to: ${figure.value}`} aria-hidden="true" />
              <span class="mb-sr-only">{figure.value}</span>
              {figure.unit && <span class="mb-figure__unit">{figure.unit}</span>}
            </p>
            <p class="mb-figure__label">{figure.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="moments" class="mb-bay mb-bay--raised" aria-labelledby="mb-moments-heading">
  <div class="mb-shell">
    <div class="mb-intro">
      <p class="mb-label"><span class="mb-dot"></span>{home.moments.label}</p>
      <h2 id="mb-moments-heading">{home.moments.heading}</h2>
      <p>{home.moments.body}</p>
    </div>
    <ul class="mb-moments">
      {
        moments.map((moment) => (
          <li>
            <picture class="mb-moments__photo">
              <source
                type="image/avif"
                srcset={`${moment.file}-640.avif 640w, ${moment.file}-960.avif 960w`}
                sizes="(min-width: 52rem) 24rem, calc(100vw - 2rem)"
              />
              <img
                src={`${moment.file}-640.webp`}
                srcset={`${moment.file}-640.webp 640w, ${moment.file}-960.webp 960w`}
                sizes="(min-width: 52rem) 24rem, calc(100vw - 2rem)"
                alt={moment.alt}
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="mb-moments__text">
              <p class="mb-moments__index" aria-hidden="true">
                {moment.index}
              </p>
              <h3>{moment.title}</h3>
              <p>{moment.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="privacy" class="mb-bay" aria-labelledby="mb-trust-heading">
  <div class="mb-shell">
    <div class="mb-intro">
      <p class="mb-label"><span class="mb-dot"></span>{home.trust.label}</p>
      <h2 id="mb-trust-heading">{home.trust.heading}</h2>
      <p>{home.trust.body}</p>
    </div>
    <ul class="mb-facts">
      {
        home.trust.items.map((fact) => (
          <li>
            <h3>{fact.title}</h3>
            <p>{fact.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mb-actions--after">
      <a class="mb-link" href={momentBackPath(locale, "privacy")}>{home.trust.link}</a>
    </p>
  </div>
</section>

<section id="app" class="mb-bay mb-bay--raised" aria-labelledby="mb-spec-heading">
  <div class="mb-shell">
    <div class="mb-intro">
      <p class="mb-label"><span class="mb-dot"></span>{home.spec.label}</p>
      <h2 id="mb-spec-heading">{home.spec.heading}</h2>
      <p>{home.spec.body}</p>
    </div>
    <dl class="mb-spec">
      {
        home.spec.rows.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mb-price">
      <p class="mb-label mb-label--quiet">{home.pricing.label}</p>
      <p class="mb-price__headline mb-two-voice">
        <span class="mb-two-voice__plain">{home.pricing.headline.plain}</span>
        <span class="mb-two-voice__serif">{home.pricing.headline.serif}</span>
      </p>
      <p class="mb-price__line">{home.pricing.line}</p>
      <p class="mb-note">{home.pricing.note}</p>
    </div>
  </div>
</section>

<section id="faq" class="mb-bay" aria-labelledby="mb-faq-heading">
  <div class="mb-shell">
    <div class="mb-intro">
      <p class="mb-label"><span class="mb-dot"></span>{home.faq.label}</p>
      <h2 id="mb-faq-heading">{home.faq.heading}</h2>
    </div>
    <dl class="mb-faq">
      {
        home.faq.items.map((item) => (
          <div>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="mb-close" aria-labelledby="mb-close-heading">
  <div class="mb-shell">
    <h2 id="mb-close-heading" class="mb-two-voice mb-two-voice--close">
      <span class="mb-two-voice__plain">{home.close.heading.plain}</span>
      <span class="mb-two-voice__serif">{home.close.heading.serif}</span>
    </h2>
    <p>{home.close.body}</p>
    <p class="mb-status__store"><span class="mb-dot"></span>{home.cta}</p>
  </div>
</section>
