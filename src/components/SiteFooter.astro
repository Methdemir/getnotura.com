---
import { localizedPath, type Destination } from "../i18n/routes";
import { translate } from "../i18n/translations";
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  localeId: string;
  destination?: Destination;
}

const { localeId, destination = "home" } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <strong>Notura</strong>
      <p>{translate(localeId, "footerSummary")}</p>
    </div>
    <nav aria-label={translate(localeId, "footerNavigation")}>
      <p class="site-footer__label">{translate(localeId, "footerExplore")}</p>
      <ul>
        <li><a href={localizedPath(localeId, "product")}>{translate(localeId, "product")}</a></li>
        <li><a href={localizedPath(localeId, "howItWorks")}>{translate(localeId, "howItWorks")}</a></li>
        <li><a href={localizedPath(localeId, "features")}>{translate(localeId, "features")}</a></li>
      </ul>
    </nav>
    <LanguageSelector localeId={localeId} destination={destination} placement="footer" />
  </div>
</footer>
