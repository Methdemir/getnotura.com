---
import { localizedPath, type Destination } from "../i18n/routes";
import { translate } from "../i18n/translations";
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  localeId: string;
  destination?: Destination;
}

const { localeId, destination = "home" } = Astro.props;
const navigation = ["product", "howItWorks", "features"] as const;
const legalNavigation = [
  { destination: "privacy", label: "privacyHeading" },
  { destination: "terms", label: "termsHeading" },
] as const;
---

<footer class="site-foot">
  <div class="site-foot__inner shell">
    <div class="site-foot__brand">
      <img
        src="/images/notura-lockup-primary.png"
        alt="Notura"
        width="192"
        height="80"
        decoding="async"
        loading="lazy"
      />
      <p>{translate(localeId, "footerSummary")}</p>
    </div>
    <nav aria-labelledby="foot-nav-heading">
      <h2 id="foot-nav-heading">{translate(localeId, "footerExplore")}</h2>
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={localizedPath(localeId, item)}>{translate(localeId, item)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby="foot-legal-heading">
      <h2 id="foot-legal-heading">{translate(localeId, "footerLegal")}</h2>
      <ul>
        {
          legalNavigation.map((item) => (
            <li>
              <a href={localizedPath(localeId, item.destination)}>
                {translate(localeId, item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div>
      <h2>{translate(localeId, "language")}</h2>
      <LanguageSelector localeId={localeId} destination={destination} placement="footer" />
    </div>
  </div>
</footer>
