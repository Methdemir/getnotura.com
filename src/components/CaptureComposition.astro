---
interface Method {
  title: string;
  body: string;
}

interface Props {
  methods: Method[];
  label: string;
}

const { methods, label } = Astro.props;
---

<div class="capture-composition" aria-label={label}>
  <div class="capture-composition__mark" aria-hidden="true">
    <img src="/favicon/notura-symbol.png" width="96" height="96" alt="" />
  </div>
  <ol>
    {methods.map((method, index) => (
      <li>
        <span class="capture-composition__number" aria-hidden="true">0{index + 1}</span>
        <div>
          <h3>{method.title}</h3>
          <p>{method.body}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
