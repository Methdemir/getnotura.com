---
interface Props {
  water: string;
  weight: string;
  progress: string;
}

const { water, weight, progress } = Astro.props;
---

<div class="progress-composition" aria-label={progress}>
  <div class="progress-composition__plot" aria-hidden="true">
    <span class="plot-line plot-line--one"></span>
    <span class="plot-line plot-line--two"></span>
    <span class="plot-line plot-line--three"></span>
    <svg viewBox="0 0 540 220" role="presentation">
      <path d="M12 172 C74 146 94 162 148 126 S252 118 302 78 S408 72 528 26" />
      <circle cx="148" cy="126" r="7" />
      <circle cx="302" cy="78" r="7" />
      <circle cx="528" cy="26" r="7" />
    </svg>
  </div>
  <ul>
    <li><span class="progress-dot progress-dot--water"></span>{water}</li>
    <li><span class="progress-dot progress-dot--weight"></span>{weight}</li>
  </ul>
</div>
