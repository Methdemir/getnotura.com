---
import { localizedPath, type Destination } from "../i18n/routes";
import { translate } from "../i18n/translations";
import BrandLink from "./BrandLink.astro";
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  localeId: string;
  destination?: Destination;
}

const { localeId, destination = "home" } = Astro.props;
const navigation = ["product", "howItWorks", "features"] as const;
---

<header class="site-header">
  <div class="site-header__inner">
    <BrandLink href={localizedPath(localeId, "home")} label={translate(localeId, "home")} />
    <nav aria-label={translate(localeId, "primaryNavigation")}>
      <ul class="primary-navigation">
        {navigation.map((item) => (
          <li>
            <a
              href={localizedPath(localeId, item)}
              aria-current={destination === item ? "page" : undefined}
            >
              {translate(localeId, item)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LanguageSelector localeId={localeId} destination={destination} />
  </div>
</header>
