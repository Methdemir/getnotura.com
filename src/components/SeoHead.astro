---
import type { AlternateLink } from "../i18n/routes";
import { defaultRobotsPolicy } from "../config/site-release";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string | undefined;
  alternates?: AlternateLink[] | undefined;
  ogLocale?: string | undefined;
  robots?: string | undefined;
  /**
   * Sub-brand overrides. Notura pages pass none of these, so their head output
   * is unchanged; a separate product published under this domain (Vergi
   * Hesabım) names itself, its icon and its own chrome colors here.
   */
  siteName?: string | undefined;
  iconHref?: string | undefined;
  themeColor?: string | undefined;
  colorScheme?: string | undefined;
}

const {
  title,
  description,
  canonicalPath,
  alternates = [],
  ogLocale,
  robots = defaultRobotsPolicy,
  siteName = "Notura",
  iconHref = "/favicon/notura-symbol.png",
  themeColor = "#F7F1E6",
  colorScheme = "light",
} = Astro.props;
const siteOrigin = Astro.site ?? new URL("https://getnotura.com");
const absoluteUrl = (path: string) => new URL(path, siteOrigin).href;
const canonicalUrl = canonicalPath ? absoluteUrl(canonicalPath) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content={colorScheme} />
<meta name="theme-color" content={themeColor} />
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<title>{title}</title>
<link rel="icon" type="image/png" href={iconHref} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{
  alternates.map((alternate) => (
    <link
      rel="alternate"
      hreflang={alternate.hreflang}
      href={absoluteUrl(alternate.href)}
    />
  ))
}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{ogLocale && <meta property="og:locale" content={ogLocale} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
