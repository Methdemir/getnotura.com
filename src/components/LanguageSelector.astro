---
import { getPublishedLocale, publishedLocales } from "../i18n/locales";
import { routeAvailability, localeSwitchPath, type Destination } from "../i18n/routes";
import { translate } from "../i18n/translations";
import Icon from "./Icon.astro";

interface Props {
  localeId: string;
  destination?: Destination;
  placement?: "header" | "footer";
}

const { localeId, destination = "home", placement = "header" } = Astro.props;
const currentLocale = getPublishedLocale(localeId);
---

<details class:list={["lang", `lang--${placement}`]}>
  <summary
    aria-label={`${translate(localeId, "changeLanguage")}. ${translate(localeId, "currentLanguage")}: ${currentLocale.nativeName}`}
  >
    <span class="lang__label" aria-hidden="true">{translate(localeId, "language")}</span>
    <span>{currentLocale.nativeName}</span>
    <Icon name="chevron" class="lang__chevron" />
  </summary>
  <ul class="lang__list" aria-label={translate(localeId, "languagePrompt")}>
    {
      publishedLocales.map((locale) => (
        <li>
          <a
            href={localeSwitchPath(locale.id, destination, routeAvailability)}
            lang={locale.htmlLang}
            hreflang={locale.hreflang}
            aria-current={locale.id === currentLocale.id ? "page" : undefined}
          >
            {locale.nativeName}
          </a>
        </li>
      ))
    }
  </ul>
</details>
