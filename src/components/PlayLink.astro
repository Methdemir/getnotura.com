---
/**
 * "Get it on Google Play" link for a published Sarper Studios app.
 *
 * The URL comes only from `playListings` in `src/config/store-availability.ts`.
 * For an app without a listing this renders nothing, so a page can include it
 * unconditionally and the link appears the day the listing is added.
 *
 * Each product page styles it through `class`; the component carries only the
 * Play glyph and the label. Plain anchor, no client JavaScript.
 */
import { playListing } from "../config/store-availability";

interface Props {
  app: string;
  locale?: "en" | "tr";
  class?: string;
  /** Overrides the default label, e.g. with a page's own localized copy. */
  label?: string;
}

const { app, locale = "en", class: className, label: customLabel } = Astro.props;
const url = playListing(app);
const label = customLabel ?? (locale === "tr" ? "Google Play'den indir" : "Get it on Google Play");
---

{
  url && (
    <a class:list={["play-link", className]} href={url} rel="noopener">
      <svg class="play-link__glyph" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path fill="#00d7fe" d="M3.6 1.8c-.3.3-.5.8-.5 1.4v17.6c0 .6.2 1.1.5 1.4l.1.1 9.9-9.9v-.2L3.7 1.7z" />
        <path fill="#ffce00" d="m16.9 15.7-3.3-3.3v-.2l3.3-3.3.1.1 3.9 2.2c1.1.6 1.1 1.7 0 2.3L17 15.6z" />
        <path fill="#ff3a44" d="M17 15.6 13.6 12 3.6 22.2c.4.4 1 .4 1.7 0L17 15.6" />
        <path fill="#00f076" d="M17 8.4 5.3 1.8c-.7-.4-1.3-.4-1.7 0L13.6 12z" />
      </svg>
      <span>{label}</span>
    </a>
  )
}

<style>
  .play-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }
  .play-link__glyph {
    flex: none;
  }
</style>
