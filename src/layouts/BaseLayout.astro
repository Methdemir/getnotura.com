---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getPublishedLocale } from "../i18n/locales";
import { alternateLinks, localizedPath, routeAvailability, type Destination } from "../i18n/routes";
import { translate } from "../i18n/translations";
import DocumentLayout from "./DocumentLayout.astro";

interface Props {
  localeId: string;
  destination?: Destination;
  title?: string | undefined;
  description?: string | undefined;
  robots?: string | undefined;
  /**
   * Overrides the self-canonical. Only the neutral root `/notura/` uses this: it is
   * the x-default entry and serves the English home, so it must canonicalise to
   * itself rather than to `/notura/en/`.
   */
  canonicalPath?: string | undefined;
}

const {
  localeId,
  destination = "home",
  title = translate(localeId, "metaHomeTitle"),
  description = translate(localeId, "metaHomeDescription"),
  robots,
  canonicalPath,
} = Astro.props;
const locale = getPublishedLocale(localeId);
---

<DocumentLayout
  lang={locale.htmlLang}
  title={title}
  description={description}
  skipLinkText={translate(localeId, "skipToContent")}
  canonicalPath={canonicalPath ?? localizedPath(localeId, destination)}
  alternates={alternateLinks(destination, routeAvailability)}
  ogLocale={locale.ogLocale}
  robots={robots}
>
  <SiteHeader localeId={localeId} destination={destination} />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <SiteFooter localeId={localeId} destination={destination} />
</DocumentLayout>
