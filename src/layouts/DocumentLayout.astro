---
import type { AlternateLink } from "../i18n/routes";
import "../styles/global.css";
import SeoHead from "../components/SeoHead.astro";

interface Props {
  lang: string;
  title: string;
  description: string;
  skipLinkText: string;
  canonicalPath?: string | undefined;
  alternates?: AlternateLink[] | undefined;
  ogLocale?: string | undefined;
  robots?: string | undefined;
}

const {
  lang,
  title,
  description,
  skipLinkText,
  canonicalPath,
  alternates,
  ogLocale,
  robots,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      alternates={alternates}
      ogLocale={ogLocale}
      robots={robots}
    />
  </head>
  <body>
    <!--
      THESIS: This surface owns the visible unknown: Notura states what it has not
      determined. It refuses the centred phone-on-gradient hero and the row of icon cards.
      OWN-WORLD: Warm cream reading ground cut against committed deep-green fields;
      quantities as proportion bands in fixed macro inks; hairline rules, no cards,
      drawn icons at one stroke weight.
      STORY: Someone who has never tracked food learns what logging is, sees that every
      estimate is reviewable, and leaves trusting the product. Nothing is installable yet,
      so reading is the journey and the close anchors instead of converting.
      FIRST VIEWPORT: Split editorial. Left on cream: heading, lede, primary action.
      Right, full-bleed to the edge: deep-green field holding a proportion field whose
      final band is an open hatch reading "not determined".
      FORM: Category standard at Oura/Whoop/Zoe craft. Canon chosen over the roll; seed eeab2d61.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">{skipLinkText}</a>
    <slot />
  </body>
</html>
